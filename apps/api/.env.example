# Copy to apps/api/.env. The repo-root .env is also loaded (LLM_PROVIDER / LLM_API_KEY / LLM_MODEL).

# PayPal: "auto" = sandbox when credentials are set, otherwise mock (no network, no money).
PAYPAL_MODE=auto
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Server
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATABASE_PATH=./agentguard.db
# CURRENCY=USD

# Optional: require "X-API-Key: <value>" on every /api route except /api/health
# AGENTGUARD_API_KEY=

# Optional: skip the LLM (regex heuristics + hard rules only)
# AGENTGUARD_OFFLINE=true
# LLM_TIMEOUT=30

# Seed the demo merchant registry on first start (TechMart, BookNook, ShadyDeals, ...)
# SEED_DEMO_DATA=true
